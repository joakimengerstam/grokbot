---
import '../styles/global.css';
import { rooreMailto, ROORE_URL } from '../lib/roore';
import {
  type Lang,
  detectLang,
  alternatePath,
  normalizePath,
  NAV_EN,
  NAV_SV,
  COPY,
} from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const path = normalizePath(Astro.url.pathname);
const lang: Lang = Astro.props.lang ?? detectLang(Astro.url.pathname);
const copy = COPY[lang];
const nav = lang === 'en' ? [...NAV_EN] : [...NAV_SV];
const homeHref = lang === 'en' ? '/' : '/sv';
const altPath = alternatePath(Astro.url.pathname);

const {
  title,
  description = copy.defaultDescription,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://grokbot.se');
const abs = (p: string) => new URL(p === '/' ? '/' : p, siteOrigin).href.replace(/\/$/, '') || new URL('/', siteOrigin).href;
const canonicalURL = abs(path === '/' ? '/' : path);
const enUrl = abs(lang === 'en' ? path : altPath);
const svUrl = abs(lang === 'sv' ? path : altPath);
const xDefaultUrl = abs('/');
const siteName = 'grokbot.se';
const ogImage = new URL('/favicon.svg', siteOrigin).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: 'https://grokbot.se/',
    inLanguage: copy.inLanguage,
    description,
    publisher: { '@id': 'https://roore.se/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://roore.se/#organization',
    name: 'Roore AB',
    url: 'https://roore.se/',
    email: 'joakim.engerstam@roore.se',
    founder: {
      '@type': 'Person',
      name: 'Joakim Engerstam',
      email: 'joakim.engerstam@roore.se',
    },
    sameAs: ['https://grokbot.se/', 'https://roore.se/'],
  },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="BkvsO6pVPVMpFb_GkXzYcHMI2X5Ipt0N1L4PI9Ucuzs" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="sv" href={svUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f6f8" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Sans:ital,wght@0,400..600;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:text-white focus:px-3 focus:py-2 focus:rounded"
      >{copy.skipToContent}</a
    >

    <header class="sticky top-0 z-40 bg-paper/85 backdrop-blur border-b border-line">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-6">
        <a href={homeHref} class="flex items-center gap-2.5 group">
          <span
            class="inline-block w-2.5 h-2.5 rounded-full bg-cobalt group-hover:bg-signal transition-colors"
            aria-hidden="true"></span>
          <span class="font-display text-[1.15rem] font-semibold tracking-tight">grokbot.se</span>
        </a>

        <nav aria-label={copy.mainNav} class="hidden md:flex items-center gap-1">
          {
            nav.map((item) => {
              const itemPath = normalizePath(item.href);
              const active = path === itemPath;
              return (
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'px-3 py-1.5 text-sm rounded-full transition-colors',
                    active ? 'bg-ink text-white' : 'text-ink-soft hover:bg-line-soft hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
          <span class="ml-2 flex items-center gap-0.5 text-sm" aria-label="Language">
            <a
              href={lang === 'en' ? (path === '/' ? '/' : path) : altPath}
              hreflang="en"
              lang="en"
              class:list={[
                'px-2 py-1 rounded-full font-medium',
                lang === 'en' ? 'bg-line-soft text-ink' : 'text-muted hover:text-ink',
              ]}
              aria-current={lang === 'en' ? 'true' : undefined}
            >EN</a>
            <span class="text-muted/50" aria-hidden="true">·</span>
            <a
              href={lang === 'sv' ? path : altPath}
              hreflang="sv"
              lang="sv"
              class:list={[
                'px-2 py-1 rounded-full font-medium',
                lang === 'sv' ? 'bg-line-soft text-ink' : 'text-muted hover:text-ink',
              ]}
              aria-current={lang === 'sv' ? 'true' : undefined}
            >SV</a>
          </span>
          <a
            href={rooreMailto('grokbot.se header', lang)}
            class="ml-2 px-3.5 py-1.5 text-sm rounded-full bg-cobalt text-white hover:bg-ink transition-colors whitespace-nowrap"
          >
            {copy.book15}
          </a>
        </nav>

        <details class="md:hidden relative">
          <summary
            class="list-none cursor-pointer text-sm px-3 py-1.5 rounded-full border border-line bg-panel select-none"
            >{copy.menu}</summary
          >
          <nav
            aria-label={copy.mainNav}
            class="absolute right-0 mt-2 w-52 bg-panel border border-line rounded-lg shadow-lg p-1.5 flex flex-col"
          >
            {
              nav.map((item) => {
                const itemPath = normalizePath(item.href);
                const active = path === itemPath;
                return (
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'px-3 py-2 text-sm rounded-md',
                      active ? 'bg-ink text-white' : 'text-ink-soft hover:bg-line-soft',
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })
            }
            <div class="flex gap-1 px-3 py-2 text-sm">
              <a href={lang === 'en' ? (path === '/' ? '/' : path) : altPath} hreflang="en" class={lang === 'en' ? 'font-semibold text-ink' : 'text-muted'}>EN</a>
              <span class="text-muted/50">·</span>
              <a href={lang === 'sv' ? path : altPath} hreflang="sv" class={lang === 'sv' ? 'font-semibold text-ink' : 'text-muted'}>SV</a>
            </div>
            <a
              href={rooreMailto('grokbot.se meny', lang)}
              class="mt-1 px-3 py-2 text-sm rounded-md bg-cobalt text-white text-center"
            >
              {copy.book15Roore}
            </a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line mt-24">
      <div
        class="max-w-6xl mx-auto px-5 sm:px-8 py-10 grid gap-8 md:grid-cols-[1fr_auto] items-start text-sm text-muted"
      >
        <div class="max-w-xl space-y-3">
          <p class="font-display text-ink text-base font-semibold">grokbot.se</p>
          <p>
            {
              lang === 'en' ? (
                <>
                  A guide from{' '}
                  <a href={ROORE_URL} class="text-ink underline underline-offset-3 decoration-line hover:decoration-ink">Roore AB</a>
                  , Stockholm. We build flows that prepare invoices, orders and email in your systems — you approve
                  before anything proceeds.{' '}
                  <a href={rooreMailto('grokbot.se footer', lang)} class="text-cobalt underline underline-offset-3">{copy.book15Link}</a>.
                </>
              ) : (
                <>
                  En guide från{' '}
                  <a href={ROORE_URL} class="text-ink underline underline-offset-3 decoration-line hover:decoration-ink">Roore AB</a>
                  , Stockholm. Vi bygger flöden som förbereder fakturor, ordrar och mejl i era system – ni godkänner
                  innan något går vidare.{' '}
                  <a href={rooreMailto('grokbot.se footer', lang)} class="text-cobalt underline underline-offset-3">{copy.book15Link}</a>.
                </>
              )
            }
          </p>
          <p class="text-xs">{copy.disclaimer}</p>
        </div>
        <nav aria-label={copy.footerNav} class="flex flex-wrap gap-x-5 gap-y-2 md:justify-end">
          {nav.map((item) => <a href={item.href} class="hover:text-ink">{item.label}</a>)}
          <a href={ROORE_URL} class="hover:text-ink">roore.se ↗</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
