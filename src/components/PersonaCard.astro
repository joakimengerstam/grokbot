---
/**
 * The site's core artifact: a bot's job spec.
 * Jobs are marked in cobalt, anti-jobs in signal red — the boundaries
 * are as visible as the duties.
 */
interface Props {
  name: string;
  role?: string;
  trigger?: string;
  jobs: string[];
  antiJobs: string[];
  output?: string;
  compact?: boolean;
  class?: string;
}

const { name, role, trigger, jobs, antiJobs, output, compact = false, class: className } = Astro.props;
---

<article
  class:list={[
    'bg-panel border border-line rounded-xl overflow-hidden shadow-[0_1px_0_rgb(11_18_32/0.04),0_12px_32px_-16px_rgb(11_18_32/0.18)]',
    className,
  ]}
>
  <header class="px-5 py-4 border-b border-line-soft flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow mb-1">Roll</p>
      <h3 class="font-display text-xl font-semibold leading-tight">{name}</h3>
      {role && <p class="text-sm text-muted mt-0.5">{role}</p>}
    </div>
    {
      trigger && (
        <span class="shrink-0 font-mono text-[0.7rem] px-2 py-1 rounded-md bg-cobalt-soft text-cobalt whitespace-nowrap">
          {trigger}
        </span>
      )
    }
  </header>

  <div class:list={['grid', compact ? '' : 'md:grid-cols-2', 'divide-y md:divide-y-0 md:divide-x divide-line-soft']}>
    <section class="px-5 py-4">
      <h4 class="eyebrow text-cobalt mb-3">Jobs</h4>
      <ul class="space-y-2">
        {
          jobs.map((job) => (
            <li class="flex gap-3 text-[0.9375rem] leading-snug">
              <span class="mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-cobalt" aria-hidden="true" />
              <span>{job}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="px-5 py-4 bg-[linear-gradient(to_bottom,transparent,rgb(216_50_30/0.03))]">
      <h4 class="eyebrow text-signal mb-3">Anti-jobs</h4>
      <ul class="space-y-2">
        {
          antiJobs.map((job) => (
            <li class="flex gap-3 text-[0.9375rem] leading-snug">
              <span class="mt-[0.55rem] shrink-0 w-3 h-[2px] bg-signal" aria-hidden="true" />
              <span set:html={job.replace(/\b(ALDRIG|INGA|INTE)\b/g, '<span class="font-mono text-[0.75rem] font-medium text-signal tracking-wide">$1</span>')} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  {
    output && (
      <footer class="px-5 py-3 border-t border-line-soft bg-paper/60 flex items-baseline gap-3">
        <span class="eyebrow">Output</span>
        <code class="font-mono text-[0.8rem] text-ink-soft">{output}</code>
      </footer>
    )
  }
</article>
