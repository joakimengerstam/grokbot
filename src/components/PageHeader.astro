---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="max-w-6xl mx-auto px-5 sm:px-8 pt-14 pb-10 border-b border-line">
  <p class="eyebrow mb-4">{eyebrow}</p>
  <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold leading-[1.02] max-w-3xl">{title}</h1>
  {lede && <p class="mt-5 text-lg text-muted max-w-2xl leading-relaxed">{lede}</p>}
</header>
