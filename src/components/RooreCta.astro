---
/**
 * The funnel step. Every guide page ends here: the reader has just seen how
 * much structure a good bot needs, so Roore builds it in their systems instead.
 */
import { rooreMailto, ROORE_URL, ROORE_PAGES } from '../lib/roore';
import type { Lang } from '../lib/i18n';

interface Props {
  heading?: string;
  body?: string;
  source?: string;
  /** Deep-link into a real roore.se page (managed build, not SaaS). */
  href?: string;
  lang?: Lang;
  class?: string;
}

const lang: Lang = Astro.props.lang ?? 'en';

const defaults = {
  en: {
    heading: "Don't want to build it yourself?",
    body: 'Roore builds flows that prepare invoices, orders and email in the systems you already use. You approve before anything is booked or sent. Fifteen minutes is enough to see if there is a first job.',
    eyebrow: 'Roore AB · Stockholm · we build it for you',
    bullets: ['Fortnox · Visma · Bokio', 'One flow first, fixed price', 'You approve before it proceeds'],
    cta: 'Book 15 minutes',
    more: 'Read more on roore.se ↗',
  },
  sv: {
    heading: 'Vill du inte bygga själv?',
    body: 'Roore bygger flöden som förbereder fakturor, ordrar och mejl i de system ni redan har. Ni godkänner innan något bokförs eller skickas. Femton minuter räcker för att se om det finns ett första jobb.',
    eyebrow: 'Roore AB · Stockholm · vi bygger det åt er',
    bullets: ['Fortnox · Visma · Bokio', 'Ett flöde först, fast pris', 'Ni godkänner innan det går vidare'],
    cta: 'Boka 15 minuter',
    more: 'Läs mer på roore.se ↗',
  },
}[lang];

const {
  heading = defaults.heading,
  body = defaults.body,
  source = 'grokbot.se',
  href = ROORE_PAGES.pilot,
  class: className,
} = Astro.props;

const mailto = rooreMailto(source, lang);
const learnMore = href || ROORE_URL;
---

<section
  class:list={[
    'bg-ink text-white rounded-2xl px-6 py-10 sm:px-12 sm:py-14 grid lg:grid-cols-[1fr_auto] gap-8 items-center',
    className,
  ]}
>
  <div>
    <p class="eyebrow text-white/60 mb-3">{defaults.eyebrow}</p>
    <h2 class="font-display text-3xl sm:text-4xl font-semibold leading-tight">{heading}</h2>
    <p class="mt-4 text-white/80 max-w-xl leading-relaxed">{body}</p>
    <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-white/70 font-mono">
      {defaults.bullets.map((b) => <li>{b}</li>)}
    </ul>
  </div>
  <div class="flex flex-col items-start lg:items-end gap-3">
    <a
      href={mailto}
      class="inline-flex items-center gap-2 bg-white text-ink px-5 py-3 rounded-full text-sm font-medium hover:bg-cobalt hover:text-white transition-colors"
    >
      {defaults.cta} <span aria-hidden="true">→</span>
    </a>
    <a
      href={learnMore}
      target="_blank"
      rel="noopener"
      class="text-sm text-white/70 hover:text-white underline underline-offset-3 decoration-white/30"
      >{defaults.more}</a
    >
  </div>
</section>
