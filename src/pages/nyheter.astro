---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Callout from '../components/Callout.astro';
import RooreCta from '../components/RooreCta.astro';
import { ROORE_PAGES } from '../lib/roore';

const updated = '6 september 2026';

const news = [
  { date: '5 sep', what: 'Veckokvoter nollställda för alla', why: 'Andra gången på tio dagar. Räkna inte med att det upprepas varje vecka.' },
  { date: '4 sep', what: 'Marketplace för Bot-templates. Första mallen: Haggle Bot (inköp)', why: 'Kolla här innan du bygger en Bot från noll.' },
  { date: '3 sep', what: 'Enterprise live, två veckor gratis för Grok/Cursor Enterprise', why: 'SSO går den vanliga organisations-inloggningen.' },
  { date: '2 sep', what: 'Android-app (Android 9+)', why: 'Samma Bots och konversationer synkas. iPad saknas fortfarande.' },
  { date: '31 aug', what: 'Microsoft-plugins: Outlook, Calendar, OneDrive', why: 'Plugin före browser. Byt ut webbläsarflöden mot Outlook där du kan.' },
  { date: '29 aug', what: 'Bättre X-stöd; developer-konto + krediter skapas automatiskt vid koppling', why: 'Krediterna tar slut tyst. Be X-bevakande Bots rapportera inputs, inte bara fynd.' },
  { date: '28 aug', what: 'Köp via @link (USA), dela Bot-templates', why: 'Du godkänner varje köp, Boten får ett engångskort.' },
  { date: '26 aug', what: 'Access till alla SuperGrok- och Cursor Pro-planer', why: 'Kvoterna nollställdes samtidigt.' },
];
---

<Layout
  title="Grok Bot nyheter – vad som släppts (uppdaterad september 2026)"
  description="Logg över vad xAI släppt i Grok Bot: kvotresets, Marketplace, Enterprise, Android, Microsoft-plugins, X-stöd. Med vad det betyder för din setup."
>
  <PageHeader
    eyebrow={`Nyheter · uppdaterad ${updated}`}
    title="Vad som är nytt i Grok Bot"
    lede="Från det officiella kontot @bot på X. Kolumnen till höger är vad det betyder för dig som sätter upp Bots."
  />

  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-12">
    <div class="max-w-3xl">
      <div class="bg-panel border border-line rounded-xl overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-line text-left">
              <th class="eyebrow font-normal px-5 py-3">Datum</th>
              <th class="eyebrow font-normal px-5 py-3">Vad</th>
              <th class="eyebrow font-normal px-5 py-3 hidden md:table-cell">Betyder</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line-soft">
            {
              news.map((n) => (
                <tr class="align-top">
                  <td class="px-5 py-3.5 font-mono text-[0.78rem] text-cobalt whitespace-nowrap">{n.date}</td>
                  <td class="px-5 py-3.5 text-ink">{n.what}</td>
                  <td class="px-5 py-3.5 text-ink-soft hidden md:table-cell">{n.why}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <Callout kind="note" title="Källor" class="mt-8">
        <p>
          <a href="https://x.com/bot" target="_blank" rel="noopener" class="text-cobalt underline underline-offset-3">@bot på X</a>,
          <a href="https://docs.x.ai/grok-bot/get-started" target="_blank" rel="noopener" class="text-cobalt underline underline-offset-3">docs.x.ai/grok-bot</a>,
          <a href="https://cursor.com/help/grok-bot/plans" target="_blank" rel="noopener" class="text-cobalt underline underline-offset-3">cursor.com/help/grok-bot/plans</a>.
          Fullständig källista på <a href="/om#kallor" class="text-cobalt underline underline-offset-3">Om-sidan</a>.
        </p>
      </Callout>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-8">
    <RooreCta source="grokbot.se nyheter" href={ROORE_PAGES.home} />
  </div>
</Layout>
