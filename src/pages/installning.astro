---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PersonaCard from '../components/PersonaCard.astro';
import Callout from '../components/Callout.astro';
import RooreCta from '../components/RooreCta.astro';
import { ROORE_PAGES } from '../lib/roore';

const steps = [
  { id: 'krav', label: 'Krav och plan' },
  { id: 'installera', label: 'Ladda ner appen' },
  { id: 'logga-in', label: 'Logga in' },
  { id: 'bot', label: 'Skapa Chief of Staff' },
  { id: 'uppgift', label: 'Första uppgiften' },
  { id: 'verktyg', label: 'Koppla in verktyg' },
  { id: 'skills', label: 'Skills, sedan routines' },
  { id: 'checklista', label: 'Checklista' },
];

const plans = [
  ['Cursor', 'Pro, Pro+, Ultra, Teams Standard/Premium', true],
  ['SuperGrok', 'SuperGrok, Plus, Heavy (länkas till Cursor-kontot)', true],
  ['X Premium+', 'Kan länkas som usage-grant', true],
  ['Enterprise', 'Rullas ut. Två veckor gratis för Grok/Cursor Enterprise från 3 sep 2026', true],
  ['Ingår inte', 'SuperGrok Lite, SuperGrok Team/Enterprise-länkning, Cursor Hobby/gratis', false],
] as const;

const platforms = [
  ['macOS (Apple silicon + Intel)', 'Ja'],
  ['Windows (x64 + Arm64)', 'Ja'],
  ['Linux (deb / rpm / AppImage)', 'Ja'],
  ['iPhone (iOS 18+)', 'Ja'],
  ['Android 9+', 'Ja, sedan 2 sep'],
  ['iPad', 'Nej'],
];

const fiveParts = [
  ['Resultat', 'Vad är klart när jobbet är gjort?'],
  ['Källor', 'Vilka appar, sajter, filer?'],
  ['Gränser', 'Vad får den inte göra?'],
  ['Leverans', 'Vilket format ska du få tillbaka?'],
  ['Review', 'När ska den stanna och fråga dig?'],
];

const checklist = [
  'Betald Cursor-plan, SuperGrok eller X Premium+ (eller trial)',
  'Stäng av Legacy Privacy Mode i Cursor',
  'Installera från x.ai/bot',
  'Logga in med rätt Cursor-konto',
  'Skapa en Chief of Staff, pinna den, skriv staket i beskrivningen',
  'En femdelad uppgift mot ett dokument',
  'Koppla Gmail + Calendar när du behöver dem',
  'En till uppgift i ett riktigt verktyg, drafts only',
  'Spara som skill när flödet sitter',
  'Routine på vardagsmorgon, med test run, först därefter',
];
---

<Layout
  title="Så sätter du upp Grok Bot – steg-för-steg (appen från x.ai)"
  description="Installera Grok Bot-appen, logga in med Cursor-kontot, skapa en Chief of Staff, koppla plugins och gå från skill till routine. Svensk how-to, uppdaterad september 2026."
>
  <PageHeader
    eyebrow="Kom igång · 8 steg · första kvällen"
    title="Sätt upp din första Grok Bot"
    lede="Från tom installation till en Bot med egen molndator, ett sparat arbetsflöde och en routine på vardagsmorgon."
  />

  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-12 grid lg:grid-cols-[13rem_1fr] gap-12">
    <nav aria-label="Steg" class="hidden lg:block">
      <ol class="sticky top-24 space-y-1 text-sm">
        {
          steps.map((s, i) => (
            <li>
              <a
                href={`#${s.id}`}
                class="flex items-baseline gap-3 py-1.5 text-muted hover:text-ink transition-colors"
              >
                <span class="font-mono text-[0.7rem] text-cobalt tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <span>{s.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="prose-guide max-w-2xl">
      <Callout kind="note" title="Vad du sätter upp">
        <p>
          Grok Bot är <strong>inte</strong> chatten på grok.com och inte en modell i Cursor. Det är en egen app:
          namngivna AI-kollegor med en delad molndator (webbläsare, filsystem, terminal), som loggar in i dina
          verktyg, kör schemalagda jobb och bara stör dig när något behöver godkännas.
        </p>
      </Callout>

      <section id="krav">
        <p class="eyebrow mb-2 mt-14">Steg 1</p>
        <h2 class="!mt-0">Krav och plan</h2>
        <p>Ingen separat Grok Bot-prenumeration. Access ingår i:</p>
        <div class="not-prose bg-panel border border-line rounded-lg divide-y divide-line-soft my-5">
          {
            plans.map(([name, body, ok]) => (
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-0.5 px-4 py-3">
                <span class:list={['font-display font-semibold w-28 shrink-0', ok ? '' : 'text-signal']}>{name}</span>
                <span class="text-[0.95rem] text-ink-soft">{body}</span>
              </div>
            ))
          }
        </div>
        <p>
          Det finns en <strong>gratis trial</strong> (usage-kredit + 7-dagarsfönster). Krediten äts av agentsteg och
          tokens, inte av antal meddelanden. Ett långt jobb kan tömma den på en körning.
        </p>
        <p>
          Grok Bot har <strong>egen veckokvot</strong>, skild från vanlig Cursor- och Grok-användning. Har du både
          Cursor och SuperGrok används den som ger mest. När kvoten tar slut kan arbetet fortsätta på on-demand om
          det är påslaget.
        </p>
        <Callout kind="warn" title="Två saker som inte går att ångra">
          <ul>
            <li>
              <strong>Länk av SuperGrok / X Premium+ är permanent.</strong> Den kan inte flyttas till ett annat
              Cursor-konto. Logga in med rätt konto först.
            </li>
            <li>
              <strong>Legacy Privacy Mode</strong> i Cursor måste stängas av. Grok Bot kräver molnlagring och startar
              annars inte.
            </li>
          </ul>
        </Callout>
        <h3>Plattformar (september 2026)</h3>
        <div class="not-prose bg-panel border border-line rounded-lg divide-y divide-line-soft my-5">
          {
            platforms.map(([p, status]) => (
              <div class="flex items-baseline justify-between gap-4 px-4 py-2.5 text-[0.95rem]">
                <span>{p}</span>
                <span class:list={['font-mono text-[0.75rem]', status === 'Nej' ? 'text-signal' : 'text-cobalt']}>{status}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="installera">
        <p class="eyebrow mb-2 mt-14">Steg 2</p>
        <h2 class="!mt-0">Ladda ner appen</h2>
        <ol>
          <li>Gå till <a href="https://x.ai/bot" target="_blank" rel="noopener">x.ai/bot</a></li>
          <li>Välj rätt build</li>
        </ol>
        <p><strong>macOS.</strong> Apple silicon eller Intel (Apple-meny → Om den här datorn: <em>Chip</em> = Apple silicon, <em>Processor</em> = Intel). Öppna dmg:en, dra Grok Bot till Program. Om macOS frågar: <strong>Öppna</strong>.</p>
        <p><strong>Windows.</strong> Kör installern (x64 eller Arm64), öppna från Start.</p>
        <p><strong>Linux.</strong> Under <em>More downloads</em> på x.ai/bot. <code>uname -m</code> → <code>x86_64</code> = x64, <code>aarch64</code> = Arm64.</p>
        <p><strong>iPhone / Android.</strong> App Store / Play. Samma Bots och konversationer synkas.</p>
      </section>

      <section id="logga-in">
        <p class="eyebrow mb-2 mt-14">Steg 3</p>
        <h2 class="!mt-0">Logga in</h2>
        <ol>
          <li><strong>Get started</strong> på välkomstskärmen (eller <strong>Sign In with Cursor</strong> under Settings)</li>
          <li>Slutför inloggningen i webbläsarfönstret som öppnas</li>
          <li>Gå tillbaka till Grok Bot</li>
        </ol>
        <p>
          Inloggningen är ditt <strong>Cursor-konto</strong>, inte ett separat Grok Bot-konto. Företag med SSO går
          den vanliga organisations-inloggningen.
        </p>
        <p>
          Första gången frågar appen vilka verktyg du använder. Det formar förslag på första teammate, men kopplar
          inte in verktygen åt dig. Har du bara SuperGrok eller X Premium+ (ingen Cursor-plan): länka kontot från
          Grok Bots planskärm efter inloggning.
        </p>
      </section>

      <section id="bot">
        <p class="eyebrow mb-2 mt-14">Steg 4</p>
        <h2 class="!mt-0">Skapa första Boten: Chief of Staff</h2>
        <p>
          Mönstret tutorials och X-användare landar på: <strong>en pinnad koordinator som du pratar med</strong>, som
          delegerar till specialister.
        </p>
        <ol>
          <li>Välj en föreslagen teammate, eller <strong>New</strong> (<code>Cmd/Ctrl+N</code>) → <strong>Create new agent</strong></li>
          <li><strong>Bot actions → Edit Profile:</strong> namn, titel, beskrivning, avatar</li>
          <li>Pinna den</li>
        </ol>
        <p>Beskrivningen är systemprompten. Skriv den som ett jobb, inte som en personlighet.</p>
        <div class="not-prose my-6">
          <PersonaCard
            name="Chief of Staff"
            role="Din enda generalist. Pinnad. Den du pratar med."
            trigger="On-demand"
            jobs={[
              'Prata med mig, bryt ner arbete, delegera till specialist-Bots',
              'Håll svar korta',
              'Om inget har ändrats sedan senast: skicka ingenting',
            ]}
            antiJobs={[
              'Skicka, publicera, köp, radera eller ändra ALDRIG produktion utan mitt godkännande',
              'Skapa INGA nya Bots utan att fråga först',
            ]}
          />
        </div>
        <Callout kind="tip" title="Onboarding-tricket">
          <p>
            Dumpa vem du är och hur du jobbar, fråga sedan <em>"hur skulle du sätta upp Grok Bot för mig?"</em> och
            godkänn planen. Skapa inte tio Bots dag ett. Max 50 Bots + gruppchattar per konto.
          </p>
        </Callout>
      </section>

      <section id="uppgift">
        <p class="eyebrow mb-2 mt-14">Steg 5</p>
        <h2 class="!mt-0">Första uppgiften: fem delar</h2>
        <p>Officiella get-started och X-användare är överens om vad en bra första fråga innehåller:</p>
        <ol class="not-prose !pl-0 space-y-2 my-5">
          {
            fiveParts.map(([label, what], i) => (
              <li class="flex items-baseline gap-4 bg-panel border border-line rounded-lg px-4 py-3">
                <span class="font-mono text-[0.7rem] text-cobalt tabular-nums">{i + 1}</span>
                <span class="font-display font-semibold w-20 shrink-0">{label}</span>
                <span class="text-[0.95rem] text-ink-soft">{what}</span>
              </li>
            ))
          }
        </ol>
        <p><strong>Första testet, ingen inloggning.</strong> Bifoga ett dokument:</p>
        <blockquote
          class="not-prose my-5 bg-panel border border-line rounded-lg px-5 py-4 font-mono text-[0.85rem] leading-relaxed text-ink-soft"
        >
          “Sammanfatta dokumentet i fem punkter. Lista datum, beslut och öppna frågor i egna sektioner. Ange
          sida/avsnitt för varje punkt. Ändra inte källfilen.”
        </blockquote>
        <p><strong>Andra testet, i ett riktigt verktyg:</strong></p>
        <blockquote
          class="not-prose my-5 bg-panel border border-line rounded-lg px-5 py-4 font-mono text-[0.85rem] leading-relaxed text-ink-soft"
        >
          “Öppna vår analytics-dashboard och jämför nya användares aktivering den här veckan med de fyra föregående.
          Peka ut det största steget som ändrats och skriv en kort undersökningsplan med länkar till graferna. Ändra
          inga dashboards. Be mig logga in om det behövs.”
        </blockquote>
      </section>

      <section id="verktyg">
        <p class="eyebrow mb-2 mt-14">Steg 6</p>
        <h2 class="!mt-0">Koppla in verktyg</h2>
        <h3>Plugins (förstahandsval)</h3>
        <ol>
          <li><strong>Settings → Plugins</strong></li>
          <li><strong>Add</strong> på det du behöver</li>
          <li>Autentisera i webbläsaren</li>
          <li>I chatten: <code>@</code> för connector, <code>/</code> för skill</li>
        </ol>
        <p>
          Börja med mail + kalender. X-pluginet skapar automatiskt ett developer-konto med startkrediter när du
          kopplar din X-profil. Microsoft-plugin finns för Outlook, Calendar och OneDrive.
        </p>
        <p>Plugins är <strong>konto-vida</strong>. En inloggning gäller alla Bots.</p>
        <h3>Webbläsaren (när det inte finns plugin)</h3>
        <p>När Boten når en inloggning ber den dig ta över:</p>
        <ol>
          <li>Öppna <strong>Agent Computer</strong> i konversationen</li>
          <li>Ta över kontrollen</li>
          <li>Skriv lösenord / 2FA / CAPTCHA själv</li>
          <li>Lämna tillbaka kontrollen</li>
        </ol>
        <Callout kind="warn">
          <p>
            Klistra <strong>inte</strong> in lösenord eller engångskoder i chatten. Sessionen sparas på molndatorn.
            Alla dina Bots delar den datorn: inloggningar, cookies och filer. Skärmarna är inte en säkerhetsgräns.
          </p>
        </Callout>
      </section>

      <section id="skills">
        <p class="eyebrow mb-2 mt-14">Steg 7</p>
        <h2 class="!mt-0">Skills, sedan routines</h2>
        <p>Ordningen i docs, och det builders på X upprepar:</p>
        <p class="not-prose font-mono text-[0.85rem] text-cobalt bg-cobalt-soft rounded-lg px-4 py-3 my-5">
          en gång → gör den pålitlig → spara som skill → testa → först då schema
        </p>
        <p>
          En routine ärver varje outtalat antagande i uppgiften den byggdes av. En felaktig morgonrutin kan köra fyra
          dagar innan du märker det.
        </p>
        <h3>Spara en skill</h3>
        <blockquote
          class="not-prose my-5 bg-panel border border-line rounded-lg px-5 py-4 font-mono text-[0.85rem] leading-relaxed text-ink-soft"
        >
          “Spara processen vi just använde som en skill som heter "Veckovis kontohälsa". Ta med källsystem,
          riskdefinitioner, outputformat och regeln att kundkontakt alltid kräver godkännande.”
        </blockquote>
        <p>
          En bra skill säger: när den ska användas, vilka inputs, stegordning, hur resultatet valideras, vad som ska
          tillbaka, vad som kräver godkännande.
        </p>
        <p>
          <strong>Teach a task</strong> (om knappen syns): öppna datorvyn, spela in max 10 minuter, granska
          draft-skillen, testa på ett säkert exempel. Inget mikroljud. Visa inte hemligheter i inspelningen.
        </p>
        <h3>Skapa en routine</h3>
        <blockquote
          class="not-prose my-5 bg-panel border border-line rounded-lg px-5 py-4 font-mono text-[0.85rem] leading-relaxed text-ink-soft"
        >
          “Varje vardag kl 08:00, kör skillen X mot listan Y. Posta resultatet i den här tråden. Kontakta ingen. Om
          källan är nere: rapportera felet, hitta inte på data.”
        </blockquote>
        <p>
          Bekräfta: ägande Bot, tidzon, input, förväntat resultat, godkännandegräns, vad som händer när källan saknas.
          Sedan <strong>Test run</strong>. Ett test gör riktigt arbete, så håll skrivåtgärder bakom approval.
        </p>
        <p>
          Hantera routines via Boten → <strong>View conversation details → Routines</strong> (pausa, testa, redigera,
          historik). En Bot kan äga 50 routines. 20 senaste körningarna sparas. Borttagning har ingen ångra.
        </p>
        <Callout kind="tip">
          <p>Håll scheman på <strong>kontorstid</strong>, inte dygnet runt. Det är det vanligaste rådet mot att bränna veckokvoten.</p>
        </Callout>
      </section>

      <section id="checklista">
        <p class="eyebrow mb-2 mt-14">Steg 8</p>
        <h2 class="!mt-0">Checklista första kvällen</h2>
        <ol class="not-prose !pl-0 space-y-2 my-5">
          {
            checklist.map((item, i) => (
              <li class="flex items-baseline gap-4 bg-panel border border-line rounded-lg px-4 py-3">
                <span class="font-mono text-[0.7rem] text-cobalt tabular-nums w-5">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[0.95rem]">{item}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <Callout kind="ok" title="Nästa steg" class="mt-14">
        <p>Du har en fungerande Grok Bot. Fortsätt med:</p>
        <ul>
          <li><a href="/best-practices" class="text-cobalt underline underline-offset-3">Best practices</a> – godkännanden, förbrukning, säkerhet</li>
          <li><a href="/exempel" class="text-cobalt underline underline-offset-3">Exempel</a> – sju bots att kopiera</li>
          <li><a href="/nyheter" class="text-cobalt underline underline-offset-3">Nyheter</a> – vad som släppts senaste veckorna</li>
        </ul>
      </Callout>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-8">
    <RooreCta
      heading="Åtta steg för dig. Noll steg för företaget."
      body="Det här är vad det tar att sätta upp en bot på din egen dator. För fakturor, ordrar och mejl i ert affärssystem bygger Roore flödet, i era system, med ert godkännande innan något går vidare."
      source="grokbot.se kom igång"
      href={ROORE_PAGES.aiMedarbetare}
    />
  </div>
</Layout>
