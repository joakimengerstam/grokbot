---
import Layout from '../layouts/Layout.astro';
import PersonaCard from '../components/PersonaCard.astro';
import Callout from '../components/Callout.astro';
import RooreCta from '../components/RooreCta.astro';
import { rooreMailto, ROORE_PAGES } from '../lib/roore';

const rooreFlows = [
  {
    bot: 'Inbox Bot',
    flow: 'Email & cases',
    body: 'Incoming mail is sorted, summarized, and gets ready-made reply drafts. Nothing is sent without you.',
    href: ROORE_PAGES.mejlArenden,
  },
  {
    bot: 'Chief of Staff',
    flow: 'Invoices & bookkeeping',
    body: 'Supplier invoices are parsed and coded; bank statements become vouchers. You approve before anything is booked.',
    href: ROORE_PAGES.leverantorsfakturor,
  },
  {
    bot: 'Sales Bot',
    flow: 'Orders & quotes',
    body: 'Order lines from email and web forms are entered into your business system. You confirm.',
    href: ROORE_PAGES.orderFranMejl,
  },
  {
    bot: 'Research Bot',
    flow: 'Bookkeeping & reports',
    body: 'Daily numbers are compiled and sent where they belong. No more copy-paste.',
    href: ROORE_PAGES.bokforing,
  },
];

const roster = [
  { name: 'Chief of Staff', job: 'The one you talk to. Breaks down work, delegates', trigger: 'Pinned, when you ask', mode: 'On-demand' },
  { name: 'Inbox Bot', job: 'Sorts mail, suggests filters and drafts', trigger: 'Weekdays 8:00', mode: 'Routine' },
  { name: 'Sales Bot', job: 'Follows up leads, keeps CRM updated', trigger: 'Friday 4:00 pm', mode: 'Routine' },
  { name: 'SEO Bot', job: 'Analyzes copy, suggests meta and keywords', trigger: 'When you ask', mode: 'On-demand' },
  { name: 'Content Bot', job: 'Writes first drafts per channel', trigger: 'When you ask', mode: 'On-demand' },
  { name: 'Research Bot', job: 'Gathers sources, summarizes', trigger: 'When you ask', mode: 'On-demand' },
];

const reasons = [
  {
    title: 'Automate the repetitive',
    body: 'Inbox sorting, report summaries, spreadsheets. You spend time on what needs your judgment.',
  },
  {
    title: 'Specialists, not generalists',
    body: 'Each bot is good at one thing. The SEO bot optimizes for search. The Sales bot follows up sales. Small, specific roles get better results.',
  },
  {
    title: 'The bot works when you don’t',
    body: 'Routines on weekday mornings, on a cloud computer that runs without yours. You open the app to finished work.',
  },
  {
    title: 'Build a small team, not a superbot',
    body: 'Start with a Chief of Staff you talk to. Add specialists when you see patterns worth automating.',
  },
];

const concepts = [
  ['Bot', 'A named agent with a title, description (system prompt), and its own conversation'],
  ['Cloud computer', 'A persistent VM with browser, filesystem, and terminal. One computer per account, not per Bot'],
  ['Plugins', 'Connectors to Gmail, Calendar, X, Outlook, Slack, and more'],
  ['Skill', 'How a task should be done: steps, format, limits'],
  ['Routine', 'When a skill should run: schedule or event'],
  ['Teach a task', 'You show a flow on the computer; the Bot saves it as a skill (max 10 min)'],
];
---

<Layout
  lang="en"
  title="Set up Grok Bot – English guide (the app from xAI + Cursor)"
  description="Set up Grok Bot, the xAI app with its own cloud computer, plugins, skills and routines. Step-by-step English guide, updated September 2026."
  datePublished="2026-09-05"
  dateModified="2026-09-10"
>
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-5 sm:px-8 pt-16 pb-20 lg:pt-24 lg:pb-28">
    <div class="grid lg:grid-cols-[1.05fr_1fr] gap-12 lg:gap-16 items-center">
      <div>
        <p class="eyebrow mb-5 rise rise-1">Guide · Grok Bot from xAI · in English</p>
        <h1
          class="font-display text-[2.75rem] sm:text-6xl lg:text-[4.5rem] font-semibold leading-[0.98] rise rise-2"
        >
          Give your AI a <span class="text-cobalt">job description.</span>
        </h1>
        <p class="mt-6 text-lg text-muted max-w-lg leading-relaxed rise rise-3">
          A Grok Bot is an AI coworker with its own cloud computer, a clear job, clear limits, and a schedule. You
          hire specialists, not an assistant that asks about everything.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 rise rise-4">
          <a
            href="/setup/"
            class="inline-flex items-center gap-2 bg-ink text-white px-5 py-3 rounded-full text-sm font-medium hover:bg-cobalt transition-colors"
          >
            Set up your first bot
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={rooreMailto('grokbot.se hero', 'en')}
            class="inline-flex items-center px-5 py-3 rounded-full text-sm font-medium border border-line bg-panel hover:border-cobalt hover:text-cobalt transition-colors"
          >
            Or let Roore build it
          </a>
        </div>
        <p class="mt-6 text-xs text-muted font-mono rise rise-4">
          DIY: included with Cursor Pro / SuperGrok / X Premium+, one evening · Let us build: 15-minute call
        </p>
      </div>

      <div class="rise rise-3">
        <PersonaCard
          lang="en"
          name="Inbox Bot"
          role="One bot, one job. Runs automatically every weekday morning."
          trigger="Weekdays 8:00"
          jobs={[
            'Read the latest 20 emails',
            'Categorize Urgent/Normal/Can wait',
            'Flag deadlines within 48 hours',
            'If nothing changed: send nothing',
          ]}
          antiJobs={['NEVER reply to email for me', 'NEVER delete anything', 'Make NO money decisions']}
          output="/workspace/briefs/YYYY-MM-DD.md"
        />
        <p class="mt-3 text-xs text-muted text-center">
          Jobs + Don'ts + output. That's the whole structure. <span class="cursor-blink text-cobalt">▍</span>
        </p>
      </div>
    </div>
  </section>

  <!-- What is it -->
  <section class="border-y border-line bg-panel/60">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-16 grid lg:grid-cols-[1fr_2fr] gap-8 lg:gap-16">
      <h2 class="font-display text-3xl font-semibold leading-tight">What is a Grok Bot?</h2>
      <div class="prose-guide max-w-2xl">
        <p>
          Grok Bot is <strong>not</strong> the chat on grok.com. It is a separate app from xAI, signed in with your
          Cursor account: named AI coworkers with their own cloud computer, that log into your tools, run scheduled
          jobs, and only interrupt you when something needs approval.
        </p>
        <p>
          Think of it as hiring a specialist. You define what the bot is good at, which tools it may use, and what it
          <strong>must not</strong> do. Then you trigger it when you need it, or let it run on a schedule.
        </p>
        <div class="not-prose bg-panel border border-line rounded-lg divide-y divide-line-soft my-6">
          {
            concepts.map(([term, body]) => (
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-0.5 px-4 py-3">
                <span class="font-display font-semibold w-36 shrink-0">{term}</span>
                <span class="text-[0.95rem] text-ink-soft">{body}</span>
              </div>
            ))
          }
        </div>
        <p class="text-sm text-muted">
          All of your Bots share the same computer: logins, cookies, and files. Each Bot gets its own screen in the
          cloud. Included with Cursor Pro/Pro+/Ultra, SuperGrok, and X Premium+. Available for macOS, Windows, Linux,
          iPhone, and Android. Not iPad.
        </p>
      </div>
    </div>
  </section>

  <!-- Roster -->
  <section class="max-w-6xl mx-auto px-5 sm:px-8 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <p class="eyebrow mb-3">Roster</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold leading-tight">A typical team</h2>
      </div>
      <p class="text-sm text-muted max-w-sm">
        A Chief of Staff you talk to (pinned). Routines for what should always happen. On-demand for work that needs
        fresh context.
      </p>
    </div>

    <div class="bg-panel border border-line rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-line text-left">
            <th class="eyebrow font-normal px-5 py-3">Bot</th>
            <th class="eyebrow font-normal px-5 py-3 hidden sm:table-cell">Job</th>
            <th class="eyebrow font-normal px-5 py-3">Trigger</th>
            <th class="eyebrow font-normal px-5 py-3 hidden md:table-cell">Mode</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line-soft">
          {
            roster.map((r) => (
              <tr class="hover:bg-paper/70 transition-colors">
                <td class="px-5 py-3.5 font-display font-semibold text-[0.95rem] whitespace-nowrap">{r.name}</td>
                <td class="px-5 py-3.5 text-ink-soft hidden sm:table-cell">{r.job}</td>
                <td class="px-5 py-3.5 font-mono text-[0.78rem] text-ink-soft whitespace-nowrap">{r.trigger}</td>
                <td class="px-5 py-3.5 hidden md:table-cell">
                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5 font-mono text-[0.7rem] px-2 py-0.5 rounded-md',
                      r.mode === 'Routine' ? 'bg-cobalt-soft text-cobalt' : 'bg-line-soft text-ink-soft',
                    ]}
                  >
                    <span
                      class:list={['w-1.5 h-1.5 rounded-full', r.mode === 'Routine' ? 'bg-cobalt' : 'bg-muted']}
                      aria-hidden="true"
                    />
                    {r.mode}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-muted">
      Each bot has its own role. <a href="/examples/" class="text-cobalt underline underline-offset-3">See all seven →</a>
    </p>
  </section>

  <!-- Why -->
  <section class="border-t border-line">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-20">
      <p class="eyebrow mb-3">Why</p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold leading-tight mb-10">Why set up a Grok Bot?</h2>
      <div class="grid sm:grid-cols-2 gap-px bg-line border border-line rounded-xl overflow-hidden">
        {
          reasons.map((r) => (
            <div class="bg-panel p-6 sm:p-8">
              <h3 class="font-display text-lg font-semibold mb-2">{r.title}</h3>
              <p class="text-[0.95rem] text-ink-soft leading-relaxed">{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bridge: guide → Roore -->
  <section class="border-t border-line bg-panel/60">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-20">
      <div class="grid lg:grid-cols-[1fr_2fr] gap-8 lg:gap-16 mb-10">
        <div>
          <p class="eyebrow mb-3">Same idea, in your company systems</p>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold leading-tight">
            What you build on your computer, we build in your company
          </h2>
        </div>
        <div class="prose-guide max-w-2xl self-end">
          <p>
            This guide teaches you to run bots on your own computer. Roore does the same for companies: flows that
            prepare the work in Fortnox, Visma, Bokio, or the ERP you already use. Verification there is
            <strong>"you approve before anything proceeds"</strong>.
          </p>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-px bg-line border border-line rounded-xl overflow-hidden">
        {
          rooreFlows.map((f) => (
            <a
              href={f.href}
              target="_blank"
              rel="noopener"
              class="bg-panel p-6 sm:p-8 block hover:bg-paper/80 transition-colors group"
            >
              <p class="font-mono text-[0.7rem] text-muted mb-2">
                <span class="text-ink-soft">{f.bot}</span> <span aria-hidden="true">→</span>{' '}
                <span class="text-cobalt">{f.flow}</span>
              </p>
              <h3 class="font-display text-lg font-semibold mb-2 group-hover:text-cobalt transition-colors">
                {f.flow} <span class="text-muted font-normal text-sm" aria-hidden="true">↗</span>
              </h3>
              <p class="text-[0.95rem] text-ink-soft leading-relaxed">{f.body}</p>
              <p class="mt-3 text-sm text-cobalt">We build it for you →</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Funnel CTA -->
  <section class="max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-8">
    <RooreCta
      lang="en"
      heading="Fifteen minutes is enough to see if there is a first job"
      body="We look at your order, invoice, or email flow. If there is a recurring job you do by hand every week, we build that first, at a fixed price. Then you decide which flow is next."
      source="grokbot.se start"
      href={ROORE_PAGES.pilot}
    />

    <p class="mt-6 text-sm text-muted">
      Prefer to build it yourself? <a href="/setup/" class="text-cobalt underline underline-offset-3">The guide takes one evening →</a>
    </p>

    <Callout kind="warn" title="Important to know" class="mt-8">
      <p>
        This is an unofficial project, not affiliated with xAI or Cursor. The guide is written by Joakim Engerstam at
        Roore AB to help others set up Grok Bots with structure. Full disclaimer on the
        <a href="/about/" class="text-ink underline underline-offset-3">About page</a>.
      </p>
    </Callout>
  </section>
</Layout>
