---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Callout from '../../components/Callout.astro';
import RooreCta from '../../components/RooreCta.astro';
import { rooreMailto, ROORE_URL, ROORE_MAIL, ROORE_PAGES } from '../../lib/roore';

const disclaimers = [
  {
    title: 'Inofficiellt, ej affilierat',
    body: 'Projektet är inte affilierat med, godkänt av eller på något sätt kopplat till xAI, Cursor eller deras moderbolag. Det är en privat guide skriven av en tredjepartsutvecklare.',
  },
  {
    title: 'Varumärken',
    body: '"Grok" och "Grok Bot" är varumärken tillhörande xAI och/eller deras licenstagare. "Cursor" är ett varumärke tillhörande Anysphere Inc. Övriga varumärken tillhör sina ägare. Namnen används enbart beskrivande.',
  },
  {
    title: 'Ingen garanti',
    body: 'Informationen tillhandahålls i befintligt skick utan garantier. Vi garanterar inte att guiderna fungerar felfritt, är kompletta eller passar ditt användningsfall. Använd på egen risk.',
  },
  {
    title: 'Ansvar för automation',
    body: 'När du sätter upp automatiserade bots är du ansvarig för vad de gör. Skriv tydliga "gör-inte" och förstå konsekvenserna innan du kör bots i produktion. Vi tar inget ansvar för skador, dataförlust eller andra problem.',
  },
  {
    title: 'Kvot och kostnad',
    body: 'Grok Bot ingår i betalda Cursor-, SuperGrok- och X Premium+-planer och har en egen veckokvot. När den tar slut kan on-demand-debitering ta över om du slagit på det. Du ansvarar själv för att följa Usage & Billing. Länk av SuperGrok/X Premium+ till ett Cursor-konto är permanent.',
  },
  {
    title: 'Dataskydd',
    body: 'Grok Bot kräver molnlagring (Legacy Privacy Mode måste vara av). Alla dina Bots delar en molndator med inloggningar, cookies och filer. Läs xAI:s och Cursors integritetspolicyer. Lägg aldrig känslig data eller lösenord där du inte förstår hur de hanteras.',
  },
];

const sources = [
  ['Get started', 'https://docs.x.ai/grok-bot/get-started'],
  ['Create and manage Bots', 'https://docs.x.ai/grok-bot/bots'],
  ['Skills, routines and automations', 'https://docs.x.ai/grok-bot/skills-routines-and-automations'],
  ['Computer and apps', 'https://docs.x.ai/grok-bot/computer-and-apps'],
  ['Approvals, security and privacy', 'https://docs.x.ai/grok-bot/approvals-security-and-privacy'],
  ['FAQ', 'https://docs.x.ai/grok-bot/faq'],
  ['Plans and billing (Cursor)', 'https://cursor.com/help/grok-bot/plans'],
  ['Access breddad 26 aug 2026', 'https://x.ai/news/grok-bot-more-plans'],
  ['x.ai/bot', 'https://x.ai/bot'],
  ['@bot på X', 'https://x.com/bot'],
];
---

<Layout
  lang="sv"
  title="Om grokbot.se – Roore AB"
  description="Inofficiell svensk guide till Grok Bot (xAI + Cursor) från Roore AB. Källor, disclaimer, kontakt och hur managed automation skiljer sig från att bygga själv."
  datePublished="2026-09-09"
  dateModified="2026-09-10"
  breadcrumb="Om"
>
  <PageHeader
    eyebrow="Om projektet"
    title="Ett inofficiellt projekt om desktop-automation"
    lede="Skriven av Roore AB för att dela en struktur som fungerar i praktiken – och för att visa vad vi bygger åt företag."
  />

  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-12 grid lg:grid-cols-[1fr_2fr] gap-12">
    <aside class="lg:sticky lg:top-24 self-start">
      <div class="bg-panel border border-line rounded-xl p-6">
        <p class="eyebrow mb-3">Bakom sajten</p>
        <p class="font-display text-xl font-semibold">Roore AB</p>
        <p class="text-sm text-muted mt-1">Stockholm</p>
        <p class="text-[0.95rem] text-ink-soft mt-4 leading-relaxed">
          Vi bygger flöden som förbereder fakturor, ordrar och mejl i de system ni redan har – Fortnox, Visma, Bokio
          eller ert affärssystem. Ni godkänner innan något bokförs eller skickas.
        </p>
        <div class="mt-5 flex flex-col gap-2 text-sm">
          <a
            href={rooreMailto('grokbot.se om')}
            class="inline-flex items-center justify-center gap-2 bg-ink text-white px-4 py-2.5 rounded-full font-medium hover:bg-cobalt transition-colors"
            >Boka 15 minuter <span aria-hidden="true">→</span></a
          >
          <a href={ROORE_PAGES.pilot} target="_blank" rel="noopener" class="text-cobalt underline underline-offset-3 text-center"
            >Starta pilot på roore.se ↗</a
          >
          <a href={ROORE_URL} target="_blank" rel="noopener" class="text-muted underline underline-offset-3 text-center text-xs"
            >roore.se</a
          >
        </div>
      </div>
    </aside>

    <div class="prose-guide max-w-2xl">
      <h2 class="!mt-0">Vad är grokbot.se?</h2>
      <p>
        grokbot.se är en svensk guide till Grok Bot, xAI:s app för namngivna AI-kollegor med egen molndator, inloggad
        via Cursor-konto. Målet är att hjälpa dig sätta upp egna Bots på ett strukturerat sätt: specialiserade roller,
        tydliga jobb och "gör-inte", skills före routines, och godkännanden där det spelar roll.
      </p>
      <p>
        Innehållet bygger på officiella docs (docs.x.ai/grok-bot, cursor.com/help/grok-bot) och vad det officiella
        kontot @bot har släppt på X. Senast uppdaterad <strong>6 september 2026</strong>. Produkten ändras vecka för
        vecka, så kolla <a href="/sv/nyheter/">nyheter</a> och källorna nedan om något inte stämmer.
      </p>
      <p>
        Guiden drivs av <a href={ROORE_URL} target="_blank" rel="noopener">Roore AB</a>. Strukturen här är samma som
        vi använder när vi bygger flöden åt företag: ett tydligt jobb, tydliga gränser, och en människa som godkänner
        innan något går vidare. Gillar du upplägget men vill inte bygga själv? Då gör vi det.
      </p>

      <h2 id="disclaimer">Disclaimer</h2>
      <div class="not-prose grid sm:grid-cols-2 gap-px bg-line border border-line rounded-xl overflow-hidden my-6">
        {
          disclaimers.map((d) => (
            <div class="bg-panel p-5">
              <h3 class="font-display font-semibold mb-1.5 flex items-center gap-2">
                <span class="w-3 h-[2px] bg-signal shrink-0" aria-hidden="true" />
                {d.title}
              </h3>
              <p class="text-sm text-ink-soft leading-relaxed">{d.body}</p>
            </div>
          ))
        }
      </div>

      <h2 id="kallor">Källor</h2>
      <ul>
        {sources.map(([label, href]) => <li><a href={href} target="_blank" rel="noopener">{label}</a></li>)}
      </ul>

      <h2>Kontakt</h2>
      <p>
        Frågor om webbplatsen, guiderna eller Roore: <a href={`mailto:${ROORE_MAIL}`}>{ROORE_MAIL}</a>. Frågor om
        planer och fakturering: <a href="https://cursor.com/help/grok-bot/plans" target="_blank" rel="noopener">cursor.com/help</a>.
        Frågor om appen: <a href="https://docs.x.ai/grok-bot/faq" target="_blank" rel="noopener">docs.x.ai</a>.
      </p>

      <h2>Källkod</h2>
      <p>Webbplatsen är byggd med Astro och Tailwind CSS. Källkoden publiceras på GitHub när repot blir publikt.</p>

      <h2>Ändringar</h2>
      <p>
        Innehållet kan uppdateras, ändras eller tas bort utan förvarning. Guiderna följer nya funktioner i Grok Bot,
        men är inte garanterat aktuella.
      </p>

      <Callout kind="note" title="Kort version" class="mt-10">
        <ul class="list-disc pl-4">
          <li>Inofficiellt projekt, ej kopplat till xAI eller Cursor</li>
          <li>Guiderna ges i befintligt skick utan garantier</li>
          <li>Du ansvarar för vad dina bots gör och vad de förbrukar</li>
          <li>Läs xAI:s och Cursors policyer innan du börjar</li>
          <li>Alla Bots delar en molndator. Lägg aldrig dit något en annan Bot inte får använda</li>
        </ul>
      </Callout>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-8">
    <RooreCta
      lang="sv" source="grokbot.se om" href={ROORE_PAGES.home} />
  </div>
</Layout>
