---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonaCard from '../../components/PersonaCard.astro';
import Callout from '../../components/Callout.astro';
import RooreCta from '../../components/RooreCta.astro';
import { ROORE_PAGES } from '../../lib/roore';

const bots = [
  {
    id: 'chief-of-staff',
    name: 'Chief of Staff',
    role: 'Din enda generalist. Pinnad. Den du pratar med, som bryter ner arbete och delegerar till specialister.',
    trigger: 'On-demand',
    jobs: [
      'Prata med mig, bryt ner arbete, delegera till specialist-Bots',
      'Håll svar korta',
      'Läs board-filen innan du svarar, uppdatera den efter',
      'Om inget har ändrats sedan senast: skicka ingenting',
    ],
    antiJobs: [
      'Skicka, publicera, köp, radera eller ändra ALDRIG produktion utan mitt godkännande',
      'Skapa INGA nya Bots utan att fråga först',
      'Kör INGA routines själv, det gör specialisterna',
    ],
    output: '/workspace/board.md',
    prompt:
      'Beskrivningen är systemprompten. Klistra in: "Du är min enda generalist. Du pratar med mig, bryter ner arbete och delegerar till specialist-Bots. Du skickar, publicerar, köper, raderar eller ändrar produktion aldrig utan mitt godkännande. Om inget har ändrats sedan senast: skicka ingenting. Håll svar korta. Skapa inte nya Bots utan att fråga först."',
  },
  {
    id: 'inbox',
    name: 'Inbox Bot',
    role: 'Specialist på mail via Gmail- eller Outlook-plugin. Kör som routine på vardagsmorgon.',
    trigger: 'Vardagar 08:00',
    jobs: [
      'Sortera olästa mail sedan förra körningen efter prioritet och typ',
      'Identifiera nyhetsbrev och föreslå filterregler',
      'Hitta mail som behöver uppföljning ("väntar på svar")',
      'Lista mail där jag är CC:ad men inte behöver agera',
      'Skriv utkast på standardfrågor, lämna dem som drafts',
    ],
    antiJobs: ['Skicka ALDRIG mail', 'Flytta ALDRIG mail till papperskorgen', 'Avprenumerera ALDRIG från listor', 'Kör INTE mot hela backloggen dag ett'],
    output: '/workspace/briefs/YYYY-MM-DD.md',
    prompt:
      'Routine: "Varje vardag kl 08:00, kör skillen Inbox-triage mot olästa mail sedan förra körningen. Posta resultatet i den här tråden. Kontakta ingen. Om Gmail-pluginet inte svarar: rapportera felet, hitta inte på data. Om inget nytt: skicka ingenting."',
  },
  {
    id: 'sales',
    name: 'Sales Bot',
    role: 'Följer upp leads och håller CRM uppdaterat.',
    trigger: 'Fredag 16:00',
    jobs: [
      'Kolla CRM: vilka leads har inte fått uppföljning på 3+ dagar?',
      'Föreslå nästa steg per lead baserat på senaste interaktionen',
      'Skriv utkast till uppföljningsmail',
      'Uppdatera status: Väntar på uppföljning / Behöver offert / Gått vidare',
      'Flagga leads som inte svarat på 2+ uppföljningar som Cold',
    ],
    antiJobs: [
      'Skicka ALDRIG mail utan mitt godkännande',
      'Radera ALDRIG leads',
      'Erbjud ALDRIG rabatter eller pris',
      'Boka ALDRIG möten åt mig',
    ],
    prompt:
      'Spara som skill: "Spara processen vi just använde som en skill som heter Veckovis leaduppföljning. Ta med CRM som källsystem, definitionen av Cold, outputformat och regeln att kundkontakt alltid kräver godkännande."',
  },
  {
    id: 'seo',
    name: 'SEO Bot',
    role: 'Optimerar innehåll för sökmotorer.',
    trigger: 'On-demand',
    jobs: [
      'Analysera en given text för SEO',
      'Föreslå meta-title och meta-description',
      'Identifiera primära och sekundära keywords',
      'Ge konkreta förbättringar: heading-struktur, keyword-densitet, interna länkar',
      'Skriv SEO-optimerad slug/URL',
    ],
    antiJobs: ['Ändra ALDRIG texten automatiskt', 'Publicera ALDRIG något direkt', 'Offra ALDRIG läsbarhet för keywords'],
  },
  {
    id: 'content',
    name: 'Content Bot',
    role: 'Skriver första utkast och anpassar texter för olika kanaler.',
    trigger: 'On-demand',
    jobs: [
      'Skriv första utkast utifrån keywords eller ämne',
      'Anpassa text för blogg, LinkedIn, X och nyhetsbrev',
      'Matcha företagets tone of voice (ge exempel vid setup)',
      'Formatera med rubriker, listor och fetstil för läsbarhet',
      'Föreslå bilder eller diagram som förbättrar texten',
    ],
    antiJobs: [
      'Publicera ALDRIG direkt – ge alltid utkast',
      'Uppfinn ALDRIG fakta eller statistik',
      'Använd ALDRIG andras upphovsrättsskyddade material',
    ],
  },
  {
    id: 'research',
    name: 'Research Bot',
    role: 'Samlar data och sammanfattar information.',
    trigger: 'On-demand',
    jobs: [
      'Sök information om ett givet ämne, företag eller person',
      'Sammanfatta längre artiklar och papers i punktform',
      'Bygg konkurrentanalyser (vad gör de? vad saknas?)',
      'Leta trender inom ett specifikt område',
      'Citera alltid källor med länkar',
    ],
    antiJobs: ['Uppfinn ALDRIG information', 'Påstå ALDRIG något utan källa', 'Bryt ALDRIG mot upphovsrätt', 'Rapportera ALDRIG "inget nytt" utan att lista vilka källor du faktiskt öppnade'],
    prompt:
      'Be den rapportera sina inputs, inte bara fynd. En bevakning som tyst tappar X-krediter eller möter en ändrad sajtlayout kan rapportera tom scan i veckor.',
  },
  {
    id: 'life-admin',
    name: 'Life Admin Bot',
    role: 'Hanterar stora livsprojekt med många rörliga delar. Exemplet: köksrenovering.',
    trigger: 'Måndag 08:00',
    jobs: [
      'Håll koll på alla leverantörer (snickare, elektriker, VVS)',
      'Spåra deadlines och beroenden ("VVS måste vara klart innan kakel")',
      'Flagga förseningar tidigt',
      'Sammanfatta status varje vecka: klart, väntar, försenat',
      'Påminn om betalningar och fakturor',
    ],
    antiJobs: ['Boka ALDRIG leverantörer utan mitt godkännande', 'Betala ALDRIG något', 'Fatta INGA beslut om material eller design'],
  },
];
---

<Layout
  lang="sv"
  title="Grok Bot exempel – 7 roller (inbox, sales, SEO m.fl.)"
  description="Kopiera färdiga Grok Bot-roller: Chief of Staff, Inbox, Sales, SEO, Content, Research och Life Admin. Jobb, gör-inte och triggers."
  datePublished="2026-09-09"
  dateModified="2026-09-10"
  breadcrumb="Exempel"
>
  <PageHeader
    eyebrow="Exempel · 7 roller"
    title="Bots att kopiera och anpassa"
    lede="Samma struktur varje gång: jobs, gör-inte, output. Klistra in i Edit Profile, byt ut detaljerna mot din situation. Kolla också Marketplace för Bot-templates innan du bygger från noll."
  />

  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-12 grid lg:grid-cols-[13rem_1fr] gap-12">
    <nav aria-label="Bots" class="hidden lg:block">
      <ul class="sticky top-24 space-y-1 text-sm">
        {
          bots.map((b) => (
            <li>
              <a href={`#${b.id}`} class="flex items-baseline justify-between gap-3 py-1.5 text-muted hover:text-ink transition-colors">
                <span>{b.name}</span>
                <span class="font-mono text-[0.65rem] text-muted/70 whitespace-nowrap">{b.trigger === 'On-demand' ? 'on-dem.' : 'rutin'}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="max-w-3xl space-y-10">
      {
        bots.map((b) => (
          <section id={b.id} class="scroll-mt-24">
            <PersonaCard
          lang="sv"
              name={b.name}
              role={b.role}
              trigger={b.trigger}
              jobs={b.jobs}
              antiJobs={b.antiJobs}
              output={b.output}
            />
            {b.prompt && (
              <blockquote class="mt-3 bg-panel border border-line rounded-lg px-5 py-3 font-mono text-[0.8rem] leading-relaxed text-ink-soft">
                {b.prompt}
              </blockquote>
            )}
            {b.id === 'life-admin' && (
              <Callout kind="tip" title="Tips" class="mt-4">
                <p>
                  Samma koncept funkar för flytt, bröllop, rekrytering, event – vilket projekt som helst med många
                  beroenden.
                </p>
              </Callout>
            )}
          </section>
        ))
      }

      <Callout kind="note" title="Anpassa till ditt behov" class="mt-14">
        <p>
          Kopiera strukturen (jobs + gör-inte + output) och byt ut detaljerna. Kör uppgiften on-demand tills den är
          pålitlig, spara som skill, Test run, först därefter routine. Håll scheman på kontorstid. Lägg till
          specialister när du hittat mönster, och fråga Chief of Staff först.
        </p>
      </Callout>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-8">
    <RooreCta
      lang="sv"
      heading="Inbox Bot och Sales Bot, i ert affärssystem"
      body="Roore bygger motsvarande flöden för företag: leverantörsfakturor in i Fortnox, order från mejl, svarsutkast som väntar på ert ja. Ett flöde först, fast pris, veckosiffror på vad som faktiskt körs."
      source="grokbot.se exempel"
      href={ROORE_PAGES.mejlArenden}
    />
  </div>
</Layout>
